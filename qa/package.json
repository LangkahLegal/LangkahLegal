{
  "name": "langkahlegal-qa",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:auth": "playwright test --grep @auth",
    "test:e2e:explore": "playwright test --grep @explore",
    "test:e2e:consultation": "playwright test --grep @consultation",
    "test:e2e:schedule": "playwright test --grep @schedule",
    "test:e2e:bursa": "playwright test --grep @bursa",
    "test:e2e:profile": "playwright test --grep @profile",
    "test:e2e:payment": "playwright test --grep @payment",
    "test:e2e:chatbot": "playwright test --grep @chatbot",
    "test:e2e:admin": "playwright test --grep @admin",
    "test:e2e:report": "playwright show-report e2e/results/html-report",
    "test:regression": "playwright test -c playwright.regression.config.js --project=desktop-chromium --project=mobile-chromium",
    "test:regression:smoke": "playwright test -c playwright.regression.config.js --project=desktop-chromium --grep @smoke",
    "test:live-api": "playwright test -c playwright.regression.config.js --project=live-api",
    "test:all": "playwright test -c playwright.regression.config.js",
    "test:regression:html": "playwright show-report e2e/results/regression-html",
    "test:regression:report": "node e2e/regression/support/generate-report.js && node e2e/regression/support/generate-report-html.js"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "dotenv": "^16.4.7"
  }
}
