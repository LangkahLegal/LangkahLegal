# Salin menjadi .env.sit lalu isi. File .env.sit tidak ikut di-commit.

# Alamat frontend dan backend yang diuji. Backend hanya menerima origin http://localhost:3000.
SIT_BASE_URL=http://localhost:3000
SIT_API_URL=http://127.0.0.1:8000

# Kata sandi bersama semua akun uji SIT (akun dibuat otomatis saat suite dijalankan).
SIT_ACCOUNT_PASSWORD=

# Opsional: jeda antar aksi dalam milidetik agar mudah diikuti pada mode headed.
SIT_SLOWMO=

# Opsional: isi 1 agar tangkapan layar tiap langkah masuk ke laporan.
SIT_STEP_SCREENSHOT=

# SUPABASE_URL dan SUPABASE_SERVICE_ROLE_KEY dibaca dari ../backend/.env.
